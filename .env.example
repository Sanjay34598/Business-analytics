# Flask Backend Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# CORS Security Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Application Storage & Path Configurations
UPLOAD_FOLDER=backend/data/uploads
ANALYSIS_ROOT=backend/data/analysis_runs
CACHE_DIR=backend/data/cache

# Machine Learning Engine Configuration
MODEL_PATH=ml/models
PIPELINE_CONFIG=ml/pipeline/config.py

# Logging System Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Frontend React API Base URL (Used during build/runtime)
REACT_APP_API_URL=http://127.0.0.1:5000
