# Flask Backend Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Storage & Path Configurations
UPLOAD_FOLDER=backend/data/uploads
ANALYSIS_RUNS_FOLDER=backend/data/analysis_runs
CACHE_DIR=backend/data/cache

# Machine Learning Engine Configuration
MODEL_DIR=ml/models
PIPELINE_CONFIG=ml/pipeline/config.py

# Frontend API URL Configuration (Used by React)
REACT_APP_API_BASE_URL=http://127.0.0.1:5000
