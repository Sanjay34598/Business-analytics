{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://web-production-71f38.up.railway.app/api/:path*"
    },
    {
      "source": "/datasets/:path*",
      "destination": "https://web-production-71f38.up.railway.app/datasets/:path*"
    },
    {
      "source": "/health",
      "destination": "https://web-production-71f38.up.railway.app/health"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/frontend/build/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/build/index.html"
    }
  ]
}
